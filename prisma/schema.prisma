// file: prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  B2B
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

// 1. Quản lý Người dùng
model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String   @unique // SĐT là phương thức đăng nhập chính (OTP)
  passwordHash String? // Có thể null nếu đăng nhập hoàn toàn qua OTP/Social
  fullName     String
  avatarUrl    String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  orders         Order[]
  wishlistItems  Wishlist[]
  communityPosts CommunityPost[]
  reviews        Review[]
  roomDesigns    RoomDesign[]
  proposals      PriceProposal[]
}

// 2. Sổ địa chỉ giao hàng
model Address {
  id           String   @id @default(uuid())
  userId       String
  receiverName String
  phone        String
  province     String
  district     String
  ward         String
  detail       String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String   @id @map("product_id")
  slug          String   @unique
  name          String
  description   Json?    // Chứa mảng các đoạn văn PR Marketing dài
  basePrice     Float    @default(0)

  configOptions Json     @default("[]") // Cấu hình các bộ chọn động (chân sofa, vải bọc, v.v.)
  variants      Json     @default("[]") // Chi tiết biến thể gồm giá, ảnh, kích thước, chi tiết thiết kế
  videos        Json?    // Mảng chứa các URL video minh hoạ tính năng

  isBestSeller Boolean @default(false)
  isNew        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  wishlistedBy Wishlist[]
  reviews      Review[]
  proposals    PriceProposal[]

  @@map("products")
}

// 4. Giỏ hàng & Wishlist
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// 5. Đơn hàng (Hỗ trợ cả Guest Checkout & Gift Order)
model Order {
  id           String  @id @default(uuid())
  userId       String? // Null nếu là Guest Checkout
  email        String? // Để gửi email xác nhận cho Guest
  phone        String // Số điện thoại nhận hàng chính
  receiverName String
  address      String // Địa chỉ giao hàng đầy đủ dạng String

  // Tính năng Gift Order (Giao cho người khác)
  isGift           Boolean @default(false)
  giftMessage      String?
  hideInvoicePrice Boolean @default(false)

  // Tài chính
  subTotal       Decimal @db.Decimal(15, 2)
  shippingFee    Decimal @db.Decimal(15, 2)
  discountAmount Decimal @db.Decimal(15, 2)
  totalAmount    Decimal @db.Decimal(15, 2)
  promoCode      String?

  // Trạng thái & Thanh toán
  status        OrderStatus @default(PENDING)
  paymentMethod String // COD, STRIPE, MOMO
  paymentStatus String      @default("UNPAID") // UNPAID, PAID
  notes         String?
  internalNotes String? // Ghi chú nội bộ cho CSKH
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id                 String  @id @default(uuid())
  orderId            String
  productId          String
  productName        String
  variantKey         String // SKU/Variant key xác định cấu hình (ví dụ: chân sofa + màu bọc)
  variantDescription String // Mô tả cấu hình chi tiết bằng chữ
  imageUrl           String
  quantity           Int
  price              Decimal @db.Decimal(15, 2) // Giá chốt mua tại thời điểm đặt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// 6. Tính năng Trả giá (Price Negotiation)
model PriceProposal {
  id            String         @id @default(uuid())
  userId        String
  productId     String
  proposedPrice Decimal        @db.Decimal(15, 2)
  reason        String
  phone         String
  status        ProposalStatus @default(PENDING)
  counterPrice  Decimal?       @db.Decimal(15, 2) // Giá CSKH phản hồi lại
  promoCodeId   String? // Mã giảm giá được tạo tự động khi duyệt thành công
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 7. Community (Chia sẻ ảnh phòng tag sản phẩm)
model CommunityPost {
  id          String   @id @default(uuid())
  userId      String
  description String
  images      Json // Mảng String chứa tối đa 5 ảnh không gian thực tế
  tags        Json // Chứa tọa độ tag sản phẩm: [{productId, x, y}]
  style       String? // Phong cách: Minimalist, Scandinavian, Modern...
  roomType    String? // Loại phòng: Living room, Bedroom...
  likesCount  Int      @default(0)
  isApproved  Boolean  @default(false) // Phê duyệt bài đăng bởi Admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 8. Đánh giá & Phản hồi
model Review {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  rating     Int      @default(5)
  comment    String
  images     Json? // Ảnh thực tế của khách hàng khi review
  isApproved Boolean  @default(true) // Cho phép ẩn review spam
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 9. Room Planner (Lưu trữ các bản vẽ thiết kế)
model RoomDesign {
  id              String   @id @default(uuid())
  userId          String
  name            String
  backgroundImage String? // URL ảnh không gian thực tế upload lên hoặc ID mẫu có sẵn
  canvasState     Json // Dữ liệu JSON lưu tọa độ, góc xoay, màu sắc của các sản phẩm được xếp
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
