# ==========================================
# FILE MẪU CHỨA CÁC BIẾN MÔI TRƯỜNG CỦA BACKEND
# Cách dùng cho thành viên mới:
# 1. Copy file này và đổi tên thành ".env"
# 2. Điền các giá trị thật vào các biến bên dưới
# (Hỏi nhóm trưởng để lấy các mật khẩu thật)
# ==========================================

# Môi trường chạy (development, production)
NODE_ENV=development

# Cổng chạy Backend
PORT=3000

# Chuỗi kết nối đến Cơ sở dữ liệu (Database URL)
# Thay chuỗi bên dưới bằng link database thật
DATABASE_URL="mysql://username:password@host:port/database_name"

# Mã bí mật dùng để mã hóa Token đăng nhập (JWT)
JWT_SECRET="dcor_super_secret_key_2026"

# (Tùy chọn) Cấu hình Gửi Email SMTP (nếu có dùng tính năng mời admin)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
