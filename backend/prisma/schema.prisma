generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. KHÁCH HÀNG & NHÂN SỰ
// ============================================================================
enum CustomerType {
  RETAIL
  B2B
}

model Customer {
  id              String       @id @default(uuid())
  type            CustomerType @default(RETAIL)
  phone           String       @unique
  email           String?      @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  isPhoneVerified Boolean      @default(false)
  
  // B2B
  companyName     String?
  taxCode         String?

  // Thống kê & Hạng thành viên
  rewardPoints    Int          @default(0) // Điểm tích lũy (Loyalty points)
  totalSpent      BigInt       @default(0) // Tổng giá trị mua hàng (Lifetime Value) - Dùng BigInt vì tiền tệ

  // Security
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?    // Soft Delete (Cần xử lý partial unique bằng SQL tay)

  addresses       Address[]
  orders          Order[]
  cartItems       CartItem[]
  sessions        UserSession[]
  otpCodes        OtpCode[]
}

enum StaffRole {
  OWNER
  ADMIN
  SALES
  WAREHOUSE
  CONTENT
}

enum StaffStatus {
  PENDING_ACTIVATION // Vừa được tạo, chờ click link trong email
  ACTIVE
  INACTIVE
}

model StaffUser {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?    @unique // Quản lý nhập SĐT
  passwordHash    String?    // Cho phép Null vì ban đầu chưa set pass
  fullName        String
  role            StaffRole
  status          StaffStatus @default(PENDING_ACTIVATION)
  
  // Link mời (Invite Link)
  invitationToken       String?   @unique
  invitationTokenExpiry DateTime?
  
  // 2FA & Security
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?  // Nghỉ việc

  statusChanges        OrderStatusHistory[]
  sessions             UserSession[]
  stockOrdersCreated   StockOrder[]
  stockAuditsCreated   StockAudit[]         @relation("AuditCreator")
  stockAuditsAudited   StockAudit[]         @relation("AuditAuditor")
  stockTransactions    StockTransaction[]
}

model UserSession {
  id           String    @id @default(uuid())
  refreshToken String    @unique
  expiresAt    DateTime
  
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  staffId      String?
  staff        StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([staffId])
}

model OtpCode {
  id         String   @id @default(uuid())
  phone      String
  otpHash    String   // Lưu Hash của OTP
  attempts   Int      @default(0)
  expiresAt  DateTime
  
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([phone])
}

// ============================================================================
// 2. SỔ ĐỊA CHỈ 
// ============================================================================
model Address {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  receiverName String
  phone        String
  
  // Thông tin hành chính (chuẩn hóa mã để tính phí ship)
  province     String
  provinceCode String?
  district     String?
  districtCode String?
  ward         String?
  wardCode     String?
  detail       String
  isDefault    Boolean  @default(false) // Cần SQL constraint 1 user 1 default

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

// ============================================================================
// 3. SẢN PHẨM & DANH MỤC
// ============================================================================
model Category {
  id        String    @id @default(uuid())
  parentId  String?   // Phân cấp danh mục
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model Product {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  description    String?  @db.Text
  basePrice      Int      // VND (Giá từ)
  
  discountValue  Int?     
  discountType   DiscountType?
  
  images         Json     
  configOptions  Json?    
  
  isBestSeller   Boolean  @default(false)
  isNew          Boolean  @default(false)
  isActive       Boolean  @default(true)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? 

  variants       ProductVariant[] // BẮT BUỘC có ít nhất 1 variant (Default)

  // Thay các index đơn lẻ bằng Composite Index cho trang Khám Phá
  @@index([categoryId, isActive, deletedAt])
  @@index([createdAt]) 
  @@index([isBestSeller])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku           String   @unique
  name          String   
  price         Int      
  
  // TỒN KHO 
  stock         Int      @default(0)
  reservedStock Int      @default(0) 
  
  optionValues  Json?    
  isActive      Boolean  @default(true) // Ẩn biến thể thay vì xóa cứng
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems         CartItem[]
  orderItems        OrderItem[]
  warehouseStocks   WarehouseStock[]
  stockOrderItems   StockOrderItem[]
  stockAuditItems   StockAuditItem[]
  stockTransactions StockTransaction[]

  @@index([productId, isActive])
}

// ============================================================================
// 4. GIỎ HÀNG 
// ============================================================================
model CartItem {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  quantity       Int
  selectedOptions Json?   // Lưu các lựa chọn custom ngoài variant gốc (màu chân/vải)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Unique đã hoạt động đúng do variantId bắt buộc
  @@unique([customerId, variantId])
  @@index([customerId])
  @@index([variantId])
}

// ============================================================================
// 5. ĐƠN HÀNG & MỤC ĐƠN HÀNG (Dữ liệu tài chính dùng BigInt)
// ============================================================================
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  COD
  VNPAY
  BANK_TRANSFER
  CREDIT_CARD
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String   @unique 
  
  customerId       String?  
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  // SNAPSHOT ĐỊA CHỈ & B2B
  email            String?
  phone            String
  receiverName     String
  companyName      String?
  taxCode          String?
  province         String
  provinceCode     String?
  district         String?
  districtCode     String?
  ward             String?
  wardCode         String?
  detailAddress    String
  
  isGift           Boolean  @default(false)
  giftMessage      String?
  hideInvoicePrice Boolean  @default(false)
  
  // TÀI CHÍNH (BigInt cho chống tràn với B2B)
  subTotal         BigInt
  shippingFee      BigInt
  discountAmount   BigInt   @default(0)
  totalAmount      BigInt
  promoCode        String?  
  
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod 
  paymentStatus    PaymentStatus @default(UNPAID)
  
  notes            String?  @db.Text
  internalNotes    String?  @db.Text
  cancelReason     String?  @db.Text
  
  // Vận chuyển
  shippingProvider String?
  trackingCode     String?
  
  // Dòng đời Đơn hàng
  expiresAt        DateTime? // Hạn nhả tồn kho nếu không thanh toán
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          PaymentTransaction[]
  stockTransactions StockTransaction[]

  @@index([customerId])
  @@index([status, createdAt]) // Tối ưu cho Admin sort
  @@index([phone]) // Tìm kiếm của khách vãng lai
}

model OrderItem {
  id                 String  @id @default(uuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Restrict) // Chống xóa
  
  productId          String
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  productName        String
  sku                String?
  imageUrl           String
  
  // Cấu hình Custom đã chọn
  variantDescription String?
  selectedOptions    Json?   
  
  quantity           Int
  price              Int     // Giá đơn vị lúc mua (Int đủ)
  discountAmount     BigInt  @default(0) // Giảm giá trên từng món
  lineTotal          BigInt  
  
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// Bảng Lịch sử trạng thái đơn hàng (Tracking / Tranh chấp)
model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  
  status       OrderStatus
  fromStatus   OrderStatus?
  actorType    String      // 'CUSTOMER', 'SYSTEM', 'STAFF'
  notes        String?     @db.Text
  
  staffId      String?
  staff        StaffUser?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([staffId])
}

// ============================================================================
// 6. GIAO DỊCH THANH TOÁN (Đối soát)
// ============================================================================
enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  PAYMENT
  DEPOSIT
  REFUND
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict) // Chống xóa
  
  transactionCode String   // Mã VNPAY/Ngân hàng
  gatewayRef      String?  
  
  amount          BigInt
  paymentMethod   PaymentMethod
  transactionType TransactionType @default(PAYMENT)
  status          TransactionStatus @default(PENDING)
  
  rawResponse     Json?    
  
  createdAt       DateTime @default(now())

  @@unique([paymentMethod, transactionCode])
  @@index([orderId])
  @@index([gatewayRef])
  @@index([status, createdAt])
}

// ============================================================================
// 7. QUẢN LÝ TỒN KHO (INVENTORY & WAREHOUSING)
// ============================================================================

enum WarehouseType {
  CENTRAL_WAREHOUSE   // Kho tổng
  REGIONAL_WAREHOUSE  // Kho khu vực
  SHOWROOM            // Showroom trưng bày
}

model Warehouse {
  id           String        @id @default(uuid())
  code         String        @unique // e.g. KHO_TONG_HCM, KHO_HN, SR_Q1, SR_THU_DUC
  name         String        // Kho Tổng (TP.HCM)
  type         WarehouseType @default(CENTRAL_WAREHOUSE)
  address      String
  phone        String?
  managerName  String?
  isActive     Boolean       @default(true)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  stocks       WarehouseStock[]
  sourceOrders StockOrder[]       @relation("SourceWarehouse")
  destOrders   StockOrder[]       @relation("DestWarehouse")
  audits       StockAudit[]
  transactions StockTransaction[]
}

model WarehouseStock {
  id              String         @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  physicalStock   Int            @default(0) // Tồn vật lý
  reservedStock   Int            @default(0) // Tạm giữ cho đơn hàng
  safetyThreshold Int            @default(5) // Ngưỡng an toàn
  shelfLocation   String?        // Ví dụ: Kệ A-01-02
  
  updatedAt       DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([warehouseId])
  @@index([variantId])
}

enum StockOrderType {
  IMPORT      // Nhập kho
  EXPORT      // Xuất kho
  TRANSFER    // Chuyển kho nội bộ
}

enum StockOrderStatus {
  DRAFT       // Bản nháp (chưa thực tế xuất-nhập)
  PLANNED     // Lên kế hoạch xuất / nhập kho
  PROCESSING  // Đang xuất/nhập/vận chuyển (Đang chuyển hàng IN_TRANSIT)
  COMPLETED   // Đã hoàn tất thực xuất/nhập (EXPORTED / IMPORTED)
  CANCELLED   // Đã hủy lệnh
  PENDING     // Tương thích ngược
}

model StockOrder {
  id                  String           @id @default(uuid())
  orderCode           String           @unique // NK-2410-001, XK-2410-002, CK-2410-003
  type                StockOrderType
  status              StockOrderStatus @default(DRAFT)
  
  sourceLocation      String           // Tên địa điểm nguồn (kho xuất hoặc tên NCC)
  destinationLocation String           // Tên địa điểm đích (kho nhận hoặc tên khách hàng/công trình)
  
  sourceWarehouseId   String?
  sourceWarehouse     Warehouse?       @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  
  destWarehouseId     String?
  destWarehouse       Warehouse?       @relation("DestWarehouse", fields: [destWarehouseId], references: [id], onDelete: SetNull)
  
  referenceCode       String?          // Mã chứng từ (PO-..., ORD-...)
  reason              String           // Lý do xuất/nhập
  notes               String?          @db.Text
  
  creatorId           String?
  creator             StaffUser?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  
  totalQuantity       Int              @default(0)
  totalAmount         BigInt           @default(0) // VND
  
  completedAt         DateTime?        // Thời điểm hoàn tất thực xuất/nhập
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  items               StockOrderItem[]
  transactions        StockTransaction[]

  @@index([type, status])
  @@index([orderCode])
  @@index([createdAt])
}

model StockOrderItem {
  id           String         @id @default(uuid())
  stockOrderId String
  stockOrder   StockOrder     @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)
  
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  quantity     Int            // Số lượng yêu cầu trong lệnh
  unitPrice    Int            @default(0) // Đơn giá
  lineTotal    BigInt         @default(0)
  
  actualQty    Int?           // Số lượng thực giao nhận
  notes        String?
  
  createdAt    DateTime       @default(now())

  @@index([stockOrderId])
  @@index([variantId])
}

enum AuditStatus {
  DRAFT       // Phiếu nháp
  PLANNED     // Đã lên kế hoạch kiểm kê
  PENDING     // Đơn yêu cầu kiểm kê vừa tạo, CHƯA thực hiện kiểm kê
  IN_PROGRESS // Đang kiểm đếm thực tế tại kho
  COMPLETED   // Đã đối chiếu và cân bằng tồn kho
  CANCELLED   // Đã hủy đợt kiểm
}

model StockAudit {
  id               String           @id @default(uuid())
  auditCode        String           @unique // ADT-2410-001
  location         String           // Chi nhánh/Kho kiểm kê
  warehouseId      String?
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  
  status           AuditStatus      @default(PENDING) // Mặc định CHƯA thực hiện
  targetDate       DateTime?        // Ngày dự kiến kiểm kê
  completedAt      DateTime?        // Ngày giờ hoàn tất cân bằng
  
  creatorId        String?
  creator          StaffUser?       @relation("AuditCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  
  auditorId        String?
  auditor          StaffUser?       @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  
  scope            String           @default("ALL") // "ALL", "CATEGORY", "CUSTOM"
  notes            String?          @db.Text
  
  totalItemsCount  Int              @default(0) // Số SKU kiểm
  discrepancyCount Int              @default(0) // Số SKU lệch
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  items            StockAuditItem[]
  transactions     StockTransaction[]

  @@index([status, location])
  @@index([auditCode])
}

model StockAuditItem {
  id          String         @id @default(uuid())
  auditId     String
  audit       StockAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  systemStock Int            // Tồn hệ thống ghi nhận lúc tạo phiếu
  actualStock Int?           // Số đếm thực tế (null khi PENDING)
  discrepancy Int?           // actualStock - systemStock
  reason      String?        // Lý do sai lệch
  
  createdAt   DateTime       @default(now())

  @@index([auditId])
  @@index([variantId])
}

enum StockTransactionType {
  IMPORT_RECEIPT      // Nhập hàng theo lệnh
  SALES_DISPATCH      // Xuất bán đơn hàng
  TRANSFER_OUT        // Chuyển kho đi
  TRANSFER_IN         // Chuyển kho đến
  AUDIT_INCREASE      // Cân bằng kiểm kê tăng
  AUDIT_DECREASE      // Cân bằng kiểm kê giảm
  RETURN_RECEIPT      // Nhập hàng khách trả lại
  DISPOSAL_DISPATCH   // Xuất hủy hư hỏng
}

model StockTransaction {
  id             String               @id @default(uuid())
  txCode         String               @unique // TX-2410-001
  type           StockTransactionType
  
  variantId      String
  variant        ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  location       String               // Kho phát sinh giao dịch
  warehouseId    String?
  warehouse      Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  
  stockBefore    Int                  // Tồn trước biến động
  quantityChange Int                  // Số lượng thay đổi (+15 hoặc -2)
  stockAfter     Int                  // Tồn sau biến động
  
  referenceCode  String               // Mã đơn hàng, mã lệnh kho, mã kiểm kê
  stockOrderId   String?
  stockOrder     StockOrder?          @relation(fields: [stockOrderId], references: [id], onDelete: SetNull)
  
  stockAuditId   String?
  stockAudit     StockAudit?          @relation(fields: [stockAuditId], references: [id], onDelete: SetNull)
  
  orderId        String?
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  actorId        String?
  actor          StaffUser?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  
  notes          String?
  createdAt      DateTime             @default(now())

  @@index([variantId, createdAt])
  @@index([type])
  @@index([referenceCode])
  @@index([location])
}

// ============================================================================
// 8. CẤU HÌNH QUẢN TRỊ TỒN KHO & THUẾ (INVENTORY SETTINGS)
// ============================================================================

enum InventoryReasonType {
  EXPORT
  IMPORT
  AUDIT
}

model InventoryReason {
  id              String              @id @default(uuid())
  type            InventoryReasonType
  reason          String
  prefix          String
  requiresPartner Boolean             @default(false)
  partnerLabel    String?
  isActive        Boolean             @default(true)
  isSystem        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([type, reason])
  @@index([type, isActive])
  @@map("inventory_reasons")
}

model TaxRate {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  rate        Float
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("tax_rates")
}

model InventorySetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("inventory_settings")
}

